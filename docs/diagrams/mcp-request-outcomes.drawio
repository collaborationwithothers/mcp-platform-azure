        <mxCell id="q-m1" value="1. tools/call + bearer token A" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="272" as="sourcePoint" />
            <mxPoint x="450" y="272" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m2" value="2. HTTP 401: missing / invalid token&lt;br&gt;gateway policy adds WWW-Authenticate PRM challenge (RFC 9728)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="330" as="sourcePoint" />
            <mxPoint x="200" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m3" value="3. Forward token A (validate-azure-ad-token passes)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="388" as="sourcePoint" />
            <mxPoint x="700" y="388" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m4" value="4. HTTP 401: Easy Auth rejects (no valid token / wrong audience)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="446" as="sourcePoint" />
            <mxPoint x="200" y="446" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m5" value="5. HTTP 200 + JSON-RPC error {error.code -32602}&lt;br&gt;unknown tool / invalid params (MCP framework; MCP spec)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#7b1fa2;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="504" as="sourcePoint" />
            <mxPoint x="200" y="504" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m6" value="6. Dispatch get_order_status (known tool, valid params)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="562" as="sourcePoint" />
            <mxPoint x="950" y="562" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m7" value="7. HTTP 200 + isError=true: &quot;403 Forbidden - requires Orders.Read&quot;&lt;br&gt;fail closed; no downstream call" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="620" as="sourcePoint" />
            <mxPoint x="200" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m8" value="8. GET order + token B (aud = downstream)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="678" as="sourcePoint" />
            <mxPoint x="1200" y="678" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m9" value="9. HTTP 401 on internal hop: wrong audience / not allowlisted" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="736" as="sourcePoint" />
            <mxPoint x="950" y="736" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m10" value="10. HTTP 200 + isError=true: downstream call failed&lt;br&gt;(surfaced as an MCP tool error)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="794" as="sourcePoint" />
            <mxPoint x="200" y="794" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m11" value="11. HTTP 200: order data (or 404 not-found -&gt; result)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="852" as="sourcePoint" />
            <mxPoint x="950" y="852" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m12" value="12. HTTP 200 + isError=false: MCP tool result" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="910" as="sourcePoint" />
            <mxPoint x="700" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m13" value="13. HTTP 200: streamed MCP result to caller" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="968" as="sourcePoint" />
            <mxPoint x="200" y="968" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-model" value="&lt;b&gt;Three failure surfaces (they nest).&lt;/b&gt; &lt;b&gt;1. Transport&lt;/b&gt; - APIM validate-azure-ad-token and Function Easy Auth V2 reject a missing / invalid / wrong-audience token with a real &lt;b&gt;HTTP 401&lt;/b&gt; before MCP runs (gateway policy adds the RFC 9728 PRM challenge). &lt;b&gt;2. JSON-RPC protocol error&lt;/b&gt; - the request reached MCP but was not a valid call (unknown tool, invalid params); the framework returns &lt;b&gt;HTTP 200&lt;/b&gt; with a JSON-RPC &lt;i&gt;error&lt;/i&gt; object (e.g. code -32602), per the MCP spec. &lt;b&gt;3. Tool execution error&lt;/b&gt; - the tool ran and failed (missing Orders.Read -&gt; &quot;403 Forbidden&quot; text, a failed downstream call, a fail-closed principal check); it returns &lt;b&gt;HTTP 200&lt;/b&gt; with &lt;b&gt;CallToolResult.isError=true&lt;/b&gt; (src/McpTools/Tools/GetOrderStatus.cs). Only tier 1 changes the HTTP status - a client must inspect both the JSON-RPC error and isError." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1046" width="1030" height="176" as="geometry" />
        </mxCell>
        <mxCell id="q-legend" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;blue solid = request&lt;br&gt;red dashed = HTTP 401 (transport reject)&lt;br&gt;purple dashed = HTTP 200 + JSON-RPC error&lt;br&gt;amber dashed = HTTP 200 + isError=true&lt;br&gt;green solid = HTTP 200 success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1046" width="370" height="176" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
