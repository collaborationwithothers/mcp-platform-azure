        </mxCell>
        <mxCell id="q-t2" value="MCP protocol tier - HTTP stays 200; errors via JSON-RPC error or CallToolResult.isError" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#9a5a00;strokeColor=none;fillColor=none;" vertex="1" parent="1">
