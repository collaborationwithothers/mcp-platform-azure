        <mxCell id="q-t1" value="Transport tier - real HTTP status (rejected before MCP runs)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#7a1f1f;strokeColor=none;fillColor=none;" vertex="1" parent="1">
