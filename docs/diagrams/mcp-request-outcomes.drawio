            <mxPoint x="450.0" y="272.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m2" value="2. HTTP 401: missing / invalid token&#10;gateway policy adds WWW-Authenticate PRM challenge (RFC 9728)" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="450.0" y="330.0" as="sourcePoint" />
            <mxPoint x="200.0" y="330.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m3" value="3. Forward token A (validate-azure-ad-token passes)" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
