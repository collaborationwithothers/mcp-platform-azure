        <mxCell id="q-m4" value="4. HTTP 401: Easy Auth rejects (no valid token / wrong audience)" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
