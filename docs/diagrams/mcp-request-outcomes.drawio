            <mxPoint x="200.0" y="446.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m5" value="5. HTTP 200 + JSON-RPC error {error.code -32602}&#10;unknown tool / invalid params (MCP framework; MCP spec)" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#7b1fa2;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="700.0" y="504.0" as="sourcePoint" />
            <mxPoint x="200.0" y="504.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m6" value="6. Dispatch get_order_status (known tool, valid params)" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="700.0" y="562.0" as="sourcePoint" />
            <mxPoint x="950.0" y="562.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m7" value="7. HTTP 200 + isError=true: &quot;403 Forbidden - requires Orders.Read&quot;&#10;fail closed; no downstream call" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="950.0" y="620.0" as="sourcePoint" />
            <mxPoint x="200.0" y="620.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m8" value="8. GET order + token B (aud = downstream)" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="950.0" y="678.0" as="sourcePoint" />
            <mxPoint x="1200.0" y="678.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m9" value="9. HTTP 401 on internal hop: wrong audience / not allowlisted" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1200.0" y="736.0" as="sourcePoint" />
            <mxPoint x="950.0" y="736.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m10" value="10. HTTP 200 + isError=true: downstream call failed&#10;(surfaced as an MCP tool error)" style="endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="950.0" y="794.0" as="sourcePoint" />
            <mxPoint x="200.0" y="794.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m11" value="11. HTTP 200: order data (or 404 not-found -&gt; result)" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1200.0" y="852.0" as="sourcePoint" />
            <mxPoint x="950.0" y="852.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m12" value="12. HTTP 200 + isError=false: MCP tool result" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="950.0" y="910.0" as="sourcePoint" />
            <mxPoint x="700.0" y="910.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m13" value="13. HTTP 200: streamed MCP result to caller" style="endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" parent="1" edge="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="700.0" y="968.0" as="sourcePoint" />
            <mxPoint x="200.0" y="968.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-takeaway" value="Within these three tiers, only tier 1 (transport) changes the HTTP status; tiers 2-3 stay HTTP 200.&#10;NOT the whole picture. API Management also rejects inside &lt;inbound&gt;, before the MCP runtime runs:&#10;per-server 403 insufficient_scope (issue 17), per-tool -32001 (issue 18), id-validity 400 (issue 88).&#10;TWO of those three DO change the HTTP status, so do not read the line above as system-wide.&#10;Those three are post-v1.0.0 additions and are NOT depicted here. per-tool-deny-path draws&#10;the issue-18 and issue-88 ones; it starts AFTER the 403. docs/mcp-request-flow.md lists all three.&#10;A client must check the HTTP status, the JSON-RPC error object, AND CallToolResult.isError.&#10;Full explanation: ADR-006 and docs/mcp-request-flow.md." style="rounded=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40.0" y="1046.0" width="640.0" height="132" />
        </mxCell>
        <mxCell id="q-legend" value="Arrows&#10;blue solid = request&#10;red dashed = HTTP 401 (transport reject)&#10;purple dashed = HTTP 200 + JSON-RPC error&#10;amber dashed = HTTP 200 + isError=true&#10;green solid = HTTP 200 success" style="rounded=1;fillColor=#f7f7f7;strokeColor=#999999;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1090.0" y="1046.0" width="370.0" height="176.0" />
        </mxCell>
      </root>
