        <mxCell id="q-t1" value="Transport tier - real HTTP status (rejected before the tool runs)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#7a1f1f;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="230" width="560" height="18" as="geometry" />
        </mxCell>
        <mxCell id="q-t2" value="MCP protocol tier - HTTP stays 200; failures ride in CallToolResult.isError" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#9a5a00;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="486" width="620" height="18" as="geometry" />
        </mxCell>
        <mxCell id="q-m1" value="1. tools/call + bearer token A" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="272" as="sourcePoint" />
            <mxPoint x="450" y="272" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m2" value="2. HTTP 401: missing / invalid token&lt;br&gt;gateway policy adds WWW-Authenticate PRM challenge (RFC 9728)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="332" as="sourcePoint" />
            <mxPoint x="200" y="332" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m3" value="3. Forward token A (validate-azure-ad-token passes)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="392" as="sourcePoint" />
            <mxPoint x="700" y="392" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m4" value="4. HTTP 401: Easy Auth rejects (no valid token / wrong audience)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="452" as="sourcePoint" />
            <mxPoint x="200" y="452" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m5" value="5. Invoke get_order_status (Easy Auth passed; principal injected)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="512" as="sourcePoint" />
            <mxPoint x="950" y="512" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m6" value="6. HTTP 200 + isError=true: &quot;403 Forbidden - requires Orders.Read&quot;&lt;br&gt;fail closed; no downstream call" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="572" as="sourcePoint" />
            <mxPoint x="200" y="572" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m7" value="7. GET order + token B (aud = downstream)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2f5b9c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="632" as="sourcePoint" />
            <mxPoint x="1200" y="632" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m8" value="8. HTTP 401 on internal hop: wrong audience / not allowlisted" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#c62828;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="692" as="sourcePoint" />
            <mxPoint x="950" y="692" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m9" value="9. HTTP 200 + isError=true: downstream call failed&lt;br&gt;(surfaced as an MCP tool error)" style="html=1;endArrow=classic;endFill=1;rounded=0;dashed=1;strokeColor=#e8820c;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="752" as="sourcePoint" />
            <mxPoint x="200" y="752" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m10" value="10. HTTP 200: order data (or 404 not-found -&gt; result)" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1200" y="812" as="sourcePoint" />
            <mxPoint x="950" y="812" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m11" value="11. HTTP 200 + isError=false: MCP tool result" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="872" as="sourcePoint" />
            <mxPoint x="700" y="872" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-m12" value="12. HTTP 200: streamed MCP result to caller" style="html=1;endArrow=classic;endFill=1;rounded=0;strokeColor=#2e7d32;strokeWidth=1.8;fontSize=10;fontColor=#111111;labelBackgroundColor=#ffffff;spacing=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="932" as="sourcePoint" />
            <mxPoint x="200" y="932" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q-model" value="&lt;b&gt;Two-tier failure model.&lt;/b&gt; Transport tier (APIM + Easy Auth): a missing, invalid, or wrong-audience token is rejected with a real &lt;b&gt;HTTP 401&lt;/b&gt; before the tool runs; the gateway policy adds an RFC 9728 PRM challenge. MCP protocol tier: once transport auth passes, the HTTP response is &lt;b&gt;200&lt;/b&gt; and every failure - authorization (missing Orders.Read -&gt; &quot;403 Forbidden&quot; text), a failed downstream call, or a fail-closed principal check - is returned as &lt;b&gt;CallToolResult.isError=true&lt;/b&gt;. An MCP client must inspect isError, not just the HTTP status. (Source: src/McpTools/Tools/GetOrderStatus.cs.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1030" height="150" as="geometry" />
        </mxCell>
        <mxCell id="q-legend" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;blue solid = request&lt;br&gt;red dashed = HTTP 401 (transport reject)&lt;br&gt;amber dashed = HTTP 200 + isError=true&lt;br&gt;green solid = HTTP 200 success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1010" width="370" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
