<!--
  Server-scope policy for the passthrough MCP server. Rendered by
  templatefile() in main.tf (azapi_resource.mcp_server_policy); the
  interpolation and %%{ for/endfor } directives below are Terraform
  template syntax, substituted before this ever reaches APIM.

  No caller ever reads context.Response.Body here (would break MCP
  streaming; Microsoft Learn, expose-existing-mcp-server, verified
  2026-07-12).
-->
<policies>
  <inbound>
    <base />
    <!--
      MCP clients without a token get the OAuth 2.1 / RFC 9728 challenge
      directly: 401 plus a WWW-Authenticate header. This emits the gateway-ROOT
      well-known URL, NOT this server's path-inserted one, because the deployed
      type=mcp runtime rewrites the no-token challenge by inserting this server's
      path after the host (issue-9 / issue-17 live gate): the CLIENT sees
      <gateway>/<server_path>/.well-known/oauth-protected-resource, which is
      already per-server. Emitting the path-inserted form here would be
      double-prefixed by that rewrite into a broken URL. The on-error 401 below
      is NOT rewritten, so it emits the path-inserted value instead. See
      COMPATIBILITY.md and the prm_server_url comment in main.tf.
    -->
    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey("Authorization"))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>@("Bearer resource_metadata=\"${prm_root_url}\"")</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":"unauthorized","error_description":"A bearer token is required. See the WWW-Authenticate resource_metadata URL for how to obtain one."}</set-body>
        </return-response>
      </when>
    </choose>
    <!--
      Independent gateway-side check (defense in depth ahead of the
      Functions backend's own audience check): issuer via tenant-id,
      audience equal to the server app ID URI, and the allowed client
      application ids. Microsoft Learn, secure-mcp-servers and
      validate-azure-ad-token-policy, verified 2026-07-12.
    -->
    <validate-azure-ad-token tenant-id="${tenant_id}" header-name="Authorization" output-token-variable-name="jwt" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized. Access token is missing or invalid.">
      <client-application-ids>
%{ for client_id in allowed_client_application_ids ~}
        <application-id>${client_id}</application-id>
%{ endfor ~}
      </client-application-ids>
      <audiences>
        <audience>${audience}</audience>
      </audiences>
    </validate-azure-ad-token>
    <!--
      Per-server entitlement check (issue 17). After token validation, require
      THIS server's delegated scope in the scp claim OR its app role in the
      roles claim. OR, not AND: a delegated (user) token carries scp and no
      roles, an app-only token the reverse; validate-azure-ad-token's
      required-claims ANDs its entries and cannot express this (Microsoft Learn,
      validate-azure-ad-token-policy, verified 2026-08-04), so the check is a
      separate expression over the parsed token (output-token-variable-name
      above). scp is space-delimited; whether APIM stores it as one Jwt.Claims
      element or pre-splits it is undocumented, and GetValueOrDefault returns
      multi-valued claims comma-joined, so split on BOTH space and comma, which
      is correct under either behaviour (confirm at the live gate;
      COMPATIBILITY.md, 2026-08-04). Fails closed with RFC 6750
      insufficient_scope (403): the token
      is valid but under-entitled, so this is an authorization denial, not a
      discovery failure, and carries no resource_metadata.
    -->
    <choose>
      <when condition="@{
        var jwt = context.Variables.GetValueOrDefault&lt;Jwt&gt;("jwt");
        if (jwt == null) { return true; }
        var sep = new char[] { ' ', ',' };
        var scp = jwt.Claims.GetValueOrDefault("scp", "").Split(sep, System.StringSplitOptions.RemoveEmptyEntries);
        var roles = jwt.Claims.GetValueOrDefault("roles", "").Split(sep, System.StringSplitOptions.RemoveEmptyEntries);
        return !(scp.Contains("${required_scope}") || roles.Contains("${required_role}"));
      }">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>@("Bearer error=\"insufficient_scope\", error_description=\"The token is valid but lacks this server's required scope or app role.\"")</value>
          </set-header>
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":"insufficient_scope","error_description":"The token is valid but lacks this server's required scope or app role."}</set-body>
        </return-response>
      </when>
    </choose>
    <!--
      Per-tool authorization (issue 18). Runs after the per-server entitlement
      check above: a caller must clear BOTH before reaching the backend. Reads
      the JSON-RPC request body once. context.Request.Body.As<JObject>
      (preserveContent: true) is documented as ordinary and unrestricted for
      MCP-type APIs; only context.Response.Body is documented unsafe, breaks
      streaming (Microsoft Learn, expose-existing-mcp-server, verified
      2026-07-12, and re-confirmed request-body-side 2026-08-06;
      COMPATIBILITY.md). Gates on JSON-RPC method == "tools/call" only
      (tools/list and every other method fall through unchanged), then
      resolves the tool name via TWO mechanisms and prunes to whichever the
      live gate proves fires on this preview surface (operator decision,
      2026-08-06): primarily the documented gen_ai.tool.name context variable
      (Microsoft Learn, monitor-mcp-servers, an MCP tools/call telemetry
      dimension proven inbound-readable by Learn's own quota-by-key example,
      which could not function post-backend; COMPATIBILITY.md, 2026-08-06),
      falling back to the already-parsed body's params.name if that variable
      is empty.
    -->
    <set-variable name="mcpRequestBody" value="@{
      return context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
    }" />
    <set-variable name="mcpMethod" value="@{
      var body = context.Variables.GetValueOrDefault&lt;JObject&gt;("mcpRequestBody");
      return body != null ? (string)body["method"] : "";
    }" />
    <choose>
      <when condition="@(context.Variables.GetValueOrDefault&lt;string&gt;("mcpMethod", "") == "tools/call")">
        <set-variable name="mcpToolName" value="@{
          var fromContextVar = context.Variables.GetValueOrDefault&lt;string&gt;("gen_ai.tool.name", "");
          if (!string.IsNullOrEmpty(fromContextVar)) { return fromContextVar; }
          var body = context.Variables.GetValueOrDefault&lt;JObject&gt;("mcpRequestBody");
          return body?["params"]?["name"]?.ToString() ?? "";
        }" />
        <!--
          Total map lookup, default-deny (issue 18): tool_authorization_map is
          rendered as a switch over every tool name this server's map knows
          about. unrestricted entries allow unconditionally (past the
          per-server check above); scope/role entries reuse the jwt variable
          and OR semantics already established by the per-server check.
          default: allowed = false covers BOTH cases the live gate's
          set-equality assertion is designed to catch: a tool name with no
          map entry at all, and (structurally impossible here, but the same
          code path) an empty extracted name.
        -->
        <choose>
          <when condition="@{
            var jwt = context.Variables.GetValueOrDefault&lt;Jwt&gt;("jwt");
            var sep = new char[] { ' ', ',' };
            var scp = jwt != null ? jwt.Claims.GetValueOrDefault("scp", "").Split(sep, System.StringSplitOptions.RemoveEmptyEntries) : new string[0];
            var roles = jwt != null ? jwt.Claims.GetValueOrDefault("roles", "").Split(sep, System.StringSplitOptions.RemoveEmptyEntries) : new string[0];
            var toolName = context.Variables.GetValueOrDefault&lt;string&gt;("mcpToolName", "");
            bool allowed;
            switch (toolName) {
%{ for name, claim in tool_authorization_map ~}
              case "${name}":
                allowed = %{ if claim.unrestricted ~}true%{ else ~}%{ if claim.scope != null && claim.role != null ~}(scp.Contains("${claim.scope}") || roles.Contains("${claim.role}"))%{ else ~}%{ if claim.scope != null ~}scp.Contains("${claim.scope}")%{ else ~}roles.Contains("${claim.role}")%{ endif ~}%{ endif ~}%{ endif ~};
                break;
%{ endfor ~}
              default:
                allowed = false;
                break;
            }
            return !allowed;
          }">
            <!--
              Deny audit event (issue 18): every deny emits exactly one Trace
              telemetry item into Application Insights via the diagnostic
              setting bound to this API's logger, dimensioned by caller and
              tool. severity="error" is a fixed contract with that diagnostic
              setting's verbosity (also "error"). APIM only records a trace
              when severity >= the diagnostic setting's verbosity, so this
              must match exactly or the audit event is silently dropped.
              Not sampled: "all invocations of the policy will be logged"
              (Microsoft Learn, trace-policy, verified 2026-08-06;
              COMPATIBILITY.md). Placed in <inbound>, immediately before the
              deny <return-response> below: <trace> is documented only for
              inbound/outbound/backend, not on-error, so it cannot be deferred
              there.
            -->
            <trace source="issue-18-per-tool-authorization" severity="error">
              <message>@("Per-tool authorization denied for tool '" + context.Variables.GetValueOrDefault&lt;string&gt;("mcpToolName", "") + "'")</message>
              <metadata name="caller" value="@{
                var jwt = context.Variables.GetValueOrDefault&lt;Jwt&gt;("jwt");
                return jwt != null ? jwt.Claims.GetValueOrDefault("oid", jwt.Claims.GetValueOrDefault("azp", "unknown")) : "unknown";
              }" />
              <metadata name="tool" value="@(context.Variables.GetValueOrDefault&lt;string&gt;("mcpToolName", ""))" />
            </trace>
            <!--
              Deny wire shape (issue 18): a JSON-RPC 2.0 Protocol Error, id
              echoed from the parsed request, delivered over the normal
              response channel, NOT a CallToolResult with isError (that tier
              is reserved for failures during actual tool execution) and NOT
              an HTTP 401/403 ahead of any JSON-RPC envelope (that tier is
              reserved for transport/session violations). Verified directly
              against the MCP spec (2025-06-18), not Microsoft Learn;
              COMPATIBILITY.md, 2026-08-06. Code -32001 is a custom code in
              the MCP-reserved range (-32000 to -32099), deliberately not the
              spec's -32602 "Unknown tool" example: that label would misdescribe
              a mapped-but-under-entitled denial, and this is one deny path for
              both the unmapped and the under-entitled case (non-concealment:
              the wire response does not distinguish which; the audit event
              above carries the tool name for operators who need to).
            -->
            <return-response>
              <set-status code="200" reason="OK" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@{
                var body = context.Variables.GetValueOrDefault&lt;JObject&gt;("mcpRequestBody");
                var toolName = context.Variables.GetValueOrDefault&lt;string&gt;("mcpToolName", "");
                var errorResponse = new JObject {
                  ["jsonrpc"] = "2.0",
                  ["id"] = body != null ? body["id"] : null,
                  ["error"] = new JObject {
                    ["code"] = -32001,
                    ["message"] = "insufficient_scope: the caller is not authorized to call tool '" + toolName + "'."
                  }
                };
                return errorResponse.ToString(Newtonsoft.Json.Formatting.None);
              }</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <!--
      Forward the caller's validated Entra token to the backend. MCP passthrough
      does not guarantee the Authorization header reaches the backend (Microsoft
      Learn, secure-mcp-servers), and the Functions backend's Easy Auth needs it;
      the same token the client presents is accepted by the backend directly
      (verified 2026-07-16 by a direct backend probe returning 405, not 401).
    -->
    <set-header name="Authorization" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("Authorization",""))</value>
    </set-header>
  </inbound>
  <backend>
    <forward-request />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <!--
      validate-azure-ad-token's own 401 does not set WWW-Authenticate; add it
      here so every 401 from this server (missing token above, or an
      invalid/wrong-audience token here) carries the RFC 9728 challenge. This
      path emits THIS server's path-inserted PRM URL (prm_server_url), because
      the deployed type=mcp runtime does NOT rewrite the on-error challenge
      (established at the issue-17 live gate; COMPATIBILITY.md): the literal
      value reaches the client, so a second server's on-error points at its OWN
      metadata and never the shared root (server 1's document). The no-token 401
      above emits the root value instead, since the runtime rewrites THAT one
      into a per-server URL.
    -->
    <choose>
      <when condition="@(context.Response != null && context.Response.StatusCode == 401)">
        <set-header name="WWW-Authenticate" exists-action="override">
          <value>@("Bearer resource_metadata=\"${prm_server_url}\"")</value>
        </set-header>
      </when>
    </choose>
  </on-error>
</policies>
