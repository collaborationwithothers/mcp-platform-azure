<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The synthetic downstream Orders API is a standalone ASP.NET Core web API.
    It validates the Orders resource audience in-process before it serves the
    unchanged synthetic response contract. See issue #181 and
    COMPATIBILITY.md for the JWT bearer package pin.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DownstreamOrdersApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

</Project>
